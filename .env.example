# Copia este archivo a .env y cambia TODOS los valores.
# Genera secretos con:  openssl rand -base64 48

# --- Base de datos (MySQL en Docker) ---
MYSQL_ROOT_PASSWORD=cambia_esto_root
DB_USER=ct_app
DB_PASSWORD=cambia_esto_app
# init.sql crea la base "cyber_tycoon"; no cambies este nombre
DB_NAME=cyber_tycoon

# --- Seguridad de la API ---
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
ADMIN_REGISTRATION_KEY=cambia_esto_clave_maestra_docentes

# --- Red ---
# Puerto en el host. API_BIND=127.0.0.1 si SOLO se accede por túnel.
API_PORT=3000
API_BIND=0.0.0.0
# Número de proxies delante de la API. Pon 1 si usas Cloudflare Tunnel
# o Tailscale Funnel; déjalo vacío si los clientes se conectan directo.
TRUST_PROXY=

TZ=America/Mexico_City

# --- Cloudflare Tunnel (solo con --profile cloudflare) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Registro de docentes: verificación del correo institucional ---
# Dominios permitidos, separados por coma (también acepta subdominios).
# Vacío = cualquier dominio (solo se exige el código).
DOCENTES_DOMINIOS=
# "false" desactiva el código (las cuentas nuevas quedan verificadas al registrarse).
DOCENTES_VERIFICAR_CORREO=true
# Cuenta que ENVÍA los códigos. Ejemplo con Gmail: crea una "contraseña de
# aplicación" (requiere verificación en 2 pasos) y usa smtp.gmail.com, puerto 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Cyber Tycoon <correo-que-envia@ejemplo.com>"
# Solo en desarrollo: "true" escribe el código en la consola del servidor
# (docker compose logs api) en lugar de enviarlo. Nunca en el servidor real.
EMAIL_MODO_CONSOLA=false
